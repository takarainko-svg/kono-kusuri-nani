{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takarainko-svg.github.io/kono-kusuri-nani/drugs.schema.json",
  "title": "この薬、なに？ 薬剤データ",
  "type": "object",
  "required": [
    "schemaVersion",
    "appVersion",
    "drugs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "appVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "drugs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "generic",
          "brands",
          "aliases",
          "className",
          "what",
          "use",
          "common",
          "serious",
          "caution",
          "care",
          "source",
          "record"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "generic": {
            "type": "string",
            "minLength": 1
          },
          "brands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "className": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "common": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "serious": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caution": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "care": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "object",
            "required": [
              "type",
              "url",
              "revision",
              "checkedAt"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "PMDA"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://www\\.pmda\\.go\\.jp/"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "record": {
            "type": "object",
            "required": [
              "createdAt",
              "updatedAt",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "createdAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "updatedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
